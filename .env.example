ERPNEXT_URL=https://your-erpnext-instance.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Microsoft Entra app registration (client credentials flow), for MS Teams + SharePoint
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional. Defaults match the FLYONIT Projects document library.
SHAREPOINT_HOSTNAME=flyonitcomau.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/FLYONITProjects
# Website tab on the Teams group chat also needs TeamsTab.ReadWriteForChat.All (admin consent).

# Microsoft SSO callback registered in Entra and configured in Vercel/local env
MS_AUTH_REDIRECT_URI=https://flyonit-project-creation.vercel.app/auth/callback
# Comma-separated email allowlist
SSO_ALLOWED_EMAILS=mahesh@flyonit.com.au,mahesh@flyonit.com,rani@flyonit.com.au,rani@flyonit.com,purba@flyonit.com.au,purba@flyonit.com,brian@flyonit.com.au,brian@flyonit.com,tim@flyonit.com.au,tim@flyonit.com
# Use a long random value. MS_CLIENT_SECRET is used as a fallback for local compatibility.
AUTH_SESSION_SECRET=
