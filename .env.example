ERPNEXT_URL=https://your-erpnext-instance.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Microsoft Entra app registration (client credentials flow), for MS Teams + SharePoint
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional. Defaults match the FLYONIT Projects document library.
SHAREPOINT_HOSTNAME=flyonitcomau.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/FLYONITProjects
# Website tab on the Teams group chat also needs TeamsTab.ReadWriteForChat.All (admin consent).

# 4-digit passcode gate for this app
APP_PASSCODE=
